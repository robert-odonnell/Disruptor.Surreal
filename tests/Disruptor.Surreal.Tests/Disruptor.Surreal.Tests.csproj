<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- xUnit1051 nags about passing TestContext.Current.CancellationToken to every
         CT-accepting method. Useful for long-running tests; pedantic for our fast
         unit tests that already complete in &lt; 1 ms. -->
    <NoWarn>$(NoWarn);CS1591;xUnit1051</NoWarn>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Disruptor.Surreal\Disruptor.Surreal.csproj" />
  </ItemGroup>

</Project>
