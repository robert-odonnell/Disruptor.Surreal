<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Disruptor.Surreal</RootNamespace>
    <AssemblyName>Disruptor.Surreal</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackageId>Disruptor.Surreal</PackageId>
    <Description>Unofficial .NET 10 client for SurrealDB. CBOR over WebSocket. Modeled on the official Rust client; not affiliated with the SurrealDB project. Targeted to specific design goals — see the README for the feature matrix.</Description>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Formats.Cbor" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Disruptor.Surreal.Tests" />
  </ItemGroup>

</Project>
